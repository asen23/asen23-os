{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/ublue-os/bazzite"
      ],
      "groupName": "images",
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    }
  ]
}
