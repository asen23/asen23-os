{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "default:automergeDigest"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "recipes/recipe-bazzite.yaml"
      ],
      "matchStrings": [
        "registry: \\\"(?<registryUrl>[^\\\"\\\\\\s]+)\\\"\\s+repository: \\\"(?<depName>[^\\\"\\\\\\s]+)\\\"\\s+tag: \\\"(?<currentValue>[^\\\"\\\\\\s]+)\\\"\\s+digest: \\\"(?<currentDigest>[^\\\"\\\\\\s]+)\\\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
